{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "CI Agent Regression Harness results",
  "description": "Suite-level verdict file. Scenario entries are diagnostics and are not pass/block decisions. Version 1 is the original file. Version 2.0.0 (any 2.x.y string) adds an optional one-sentence caption on each scenario and arm, and an optional model_id on each arm. Decimals such as 0.05 and amounts such as $1.25 are valid caption text. A model_id is recorded text such as gemini-3.5-flash-lite and does not change the suite verdict. Extra fields are allowed so a real results.json can be dropped in at data/results.preliminary.json.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "status", "level", "likely_regression", "arms"],
  "properties": {
    "version": {
      "description": "1, or a 2.x.y schema version such as 2.0.0. Other major versions are not supported.",
      "oneOf": [
        { "const": 1 },
        { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" }
      ]
    },
    "status": { "enum": ["preliminary", "final"] },
    "level": { "const": 0.9 },
    "likely_regression": { "type": ["boolean", "null"] },
    "invalid_run": { "type": "boolean" },
    "suite": { "type": "string" },
    "notes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "summary": { "type": "string" },
        "mde": { "type": "string" },
        "aa": { "type": "string" }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "$ref": "#/$defs/arm" },
        "candidate": { "$ref": "#/$defs/arm" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "charts": {
      "type": "object",
      "properties": {
        "mde": { "$ref": "#/$defs/chart" },
        "aa": { "$ref": "#/$defs/chart" }
      }
    }
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scheduled_rollouts", "environment_misses", "miss_counts"],
      "properties": {
        "scheduled_rollouts": { "type": "integer", "minimum": 0 },
        "environment_misses": { "type": "integer", "minimum": 0 },
        "miss_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "pass_rate": { "type": "string" },
        "caption": {
          "description": "Optional one-sentence caption. Digits, decimals such as 0.05, and amounts such as $1.25 are valid text.",
          "type": "string"
        },
        "model_id": {
          "description": "Optional model id recorded for this arm. Shown when present. It does not change the suite verdict.",
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "baseline_rate": { "type": "string" },
        "candidate_rate": { "type": "string" },
        "caption": {
          "description": "Optional one-sentence caption. Digits, decimals such as 0.05, and amounts such as $1.25 are valid text.",
          "type": "string"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["preliminary", "final", "coming_soon"] },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "x_label": { "type": "string" },
        "y_label": { "type": "string" },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["budget", "drop"],
            "properties": {
              "budget": { "type": "integer", "minimum": 0 },
              "drop": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
