{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "CI Agent Regression Harness results",
  "description": "Suite-level verdict file. Scenario entries are diagnostics and are not pass/block decisions. Version 1 is the original file. Version 2.0.0 adds an optional one-sentence caption on each scenario and arm, and an optional model_id on each arm. Schema 2.1.0 (schema_version \"2.1.0\", not 3.0.0) records run_kind, baseline_pool_model_id, min_valid_fraction_per_scenario, equal rollouts_per_scenario counts, diagnostics, and verdicts.overall. On 2.1.0, verdicts.overall.likely_regression and verdicts.overall.model_ids are required. Each arm may also record model_id. suite_id is optional. An optional run_summary may record planned_rollouts, completed_rollouts, infra_misses, stopped (null or monthly_cap), total_cost_usd, total_cached_input_tokens, rollout_duration_p50_s, and rollout_duration_max_s. delta and difference_ci.level are read from verdicts.overall. Alpha and the miss cap stay in suite.yaml. There is no gate block. Fraction values are strings such as \"0.6\" and \"0.05\". Decimals such as 0.05 and amounts such as $1.25 are valid caption text. A model id does not change the suite verdict. Extra fields are allowed so a real results.json can be dropped in at data/results.preliminary.json.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "status", "level", "likely_regression", "arms"],
  "properties": {
    "version": {
      "description": "1, or a 2.x.y schema version such as 2.0.0 or 2.1.0. Other major versions are not supported. Omitted only when schema_version is a 2.x.y string.",
      "oneOf": [
        { "const": 1 },
        { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" }
      ]
    },
    "schema_version": {
      "description": "Harness schema tag. A 2.1.0 file sets this to \"2.1.0\". When version is also set, the two match. Not used on version 1.",
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$"
    },
    "run_kind": { "enum": ["screening", "baseline", "aa", "gate"] },
    "baseline_pool_model_id": { "type": "string" },
    "min_valid_fraction_per_scenario": {
      "description": "Exact fraction string, for example \"0.6\".",
      "type": "string"
    },
    "rollouts_per_scenario": {
      "description": "baseline and candidate are equal non-negative integers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "enum": ["preliminary", "final"] },
    "level": { "const": 0.9 },
    "likely_regression": { "type": ["boolean", "null"] },
    "invalid_run": { "type": "boolean" },
    "suite": { "type": "string" },
    "suite_id": {
      "description": "Optional suite id. Schema 2.1.0 does not require it.",
      "type": "string"
    },
    "run_summary": { "$ref": "#/$defs/runSummary" },
    "verdicts": {
      "description": "Suite detail. On schema 2.1.0, overall.likely_regression and overall.model_ids are required. model_ids are preferred over arms.*.model_id. delta and difference_ci are fraction strings plus a CI level. They do not change Pass, Block, Insufficient evidence, or Invalid run.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "overall": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "delta": { "type": "string" },
            "difference_ci": { "$ref": "#/$defs/differenceCi" },
            "likely_regression": { "type": "boolean" },
            "model_ids": {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseline", "candidate"],
              "properties": {
                "baseline": {
                  "description": "Baseline model id. The exact version is set in suite config.",
                  "type": "string"
                },
                "candidate": {
                  "description": "Candidate model id, for example a pinned Gemini Flash-Lite model id (exact version set in suite config).",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "notes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "summary": { "type": "string" },
        "mde": { "type": "string" },
        "aa": { "type": "string" }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "$ref": "#/$defs/arm" },
        "candidate": { "$ref": "#/$defs/arm" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "charts": {
      "type": "object",
      "properties": {
        "mde": { "$ref": "#/$defs/chart" },
        "aa": { "$ref": "#/$defs/chart" }
      }
    },
    "timing": {
      "description": "Optional efficiency field. Current results files omit it. data/timing.sample.json uses this shape, and the reader tolerates a missing timing field. Family rows are wall-clock only and are not verdicts.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gate_wall_clock_s": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "live": { "type": "number" },
            "replay": { "type": "number" }
          }
        },
        "rollout_s": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "p50": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "retries_429": { "type": "number" },
        "per_family_wall_clock_s": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "family_id": { "type": "string" },
              "seconds": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["schema_version"], "properties": { "schema_version": { "const": "2.1.0" } } },
          { "required": ["version"], "properties": { "version": { "const": "2.1.0" } } }
        ]
      },
      "then": {
        "required": ["verdicts"],
        "properties": {
          "verdicts": {
            "required": ["overall"],
            "properties": {
              "overall": {
                "required": ["likely_regression", "model_ids"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "runSummary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "planned_rollouts": { "type": "integer", "minimum": 0 },
        "completed_rollouts": { "type": "integer", "minimum": 0 },
        "infra_misses": { "type": "integer", "minimum": 0 },
        "stopped": {
          "description": "null when the run was not stopped, or monthly_cap when the spend cap stopped it.",
          "oneOf": [{ "type": "null" }, { "const": "monthly_cap" }]
        },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "total_cached_input_tokens": { "type": "integer", "minimum": 0 },
        "rollout_duration_p50_s": { "type": "number", "minimum": 0 },
        "rollout_duration_max_s": { "type": "number", "minimum": 0 }
      }
    },
    "differenceCi": {
      "type": "object",
      "additionalProperties": true,
      "required": ["lower", "upper", "level"],
      "properties": {
        "lower": { "type": "string" },
        "upper": { "type": "string" },
        "level": {
          "description": "CI level. 0.9, or the exact string \"0.9\".",
          "oneOf": [{ "const": 0.9 }, { "const": "0.9" }, { "const": "9/10" }]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scenario_id",
        "family_id",
        "scheduled_rollouts",
        "miss_counts",
        "missing_cassette_keys",
        "baseline_pass_rate",
        "candidate_pass_rate",
        "difference",
        "difference_ci"
      ],
      "properties": {
        "scenario_id": { "type": "string" },
        "family_id": { "type": "string" },
        "scheduled_rollouts": { "$ref": "#/$defs/countPair" },
        "miss_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate"],
          "properties": {
            "baseline": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "candidate": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        },
        "missing_cassette_keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate"],
          "properties": {
            "baseline": { "type": "array", "items": { "type": "string" } },
            "candidate": { "type": "array", "items": { "type": "string" } }
          }
        },
        "baseline_pass_rate": { "type": "string" },
        "candidate_pass_rate": { "type": "string" },
        "difference": { "type": "string" },
        "difference_ci": { "$ref": "#/$defs/differenceCi" }
      }
    },
    "countPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scheduled_rollouts", "environment_misses", "miss_counts"],
      "properties": {
        "scheduled_rollouts": { "type": "integer", "minimum": 0 },
        "environment_misses": { "type": "integer", "minimum": 0 },
        "miss_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "pass_rate": { "type": "string" },
        "caption": {
          "description": "Optional one-sentence caption. Digits, decimals such as 0.05, and amounts such as $1.25 are valid text.",
          "type": "string"
        },
        "model_id": {
          "description": "Optional model id recorded for this arm. Shown when present. It does not change the suite verdict.",
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "baseline_rate": { "type": "string" },
        "candidate_rate": { "type": "string" },
        "caption": {
          "description": "Optional one-sentence caption. Digits, decimals such as 0.05, and amounts such as $1.25 are valid text.",
          "type": "string"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["preliminary", "final", "coming_soon"] },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "x_label": { "type": "string" },
        "y_label": { "type": "string" },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["budget", "drop"],
            "properties": {
              "budget": { "type": "integer", "minimum": 0 },
              "drop": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
