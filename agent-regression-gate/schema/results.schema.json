{
  "$defs": {
    "AASummary": {
      "additionalProperties": false,
      "description": "A/A (same agent, twice) summary. Absent, or ``coming_soon``, until it exists.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "enum": [
                "preliminary",
                "final",
                "coming_soon"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "false_block_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Block Rate"
        },
        "false_block_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pairs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairs"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fraction of resamples whose 90% CI covers 0. Week 4 A/A check.",
          "title": "Coverage"
        },
        "caption": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One sentence for the A/A block, for a non-technical reader.",
          "title": "Caption"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "AASummary",
      "type": "object"
    },
    "ArmEnvironmentMisses": {
      "additionalProperties": false,
      "description": "Environment-miss accounting for one arm, across the document.\n\n``rate`` is ``misses / scheduled``, an exact fraction string. The\ndenominator is scheduled rollouts, not recorded outcomes.",
      "properties": {
        "scheduled": {
          "minimum": 0,
          "title": "Scheduled",
          "type": "integer"
        },
        "misses": {
          "minimum": 0,
          "title": "Misses",
          "type": "integer"
        },
        "rate": {
          "description": "Exact fraction string, such as misses/scheduled. Not a JSON number.",
          "examples": [
            "0/20",
            "1/20"
          ],
          "title": "Rate",
          "type": "string"
        }
      },
      "required": [
        "scheduled",
        "misses",
        "rate"
      ],
      "title": "ArmEnvironmentMisses",
      "type": "object"
    },
    "CaptionBlock": {
      "additionalProperties": false,
      "description": "One sentence a non-technical reader can show next to a block.",
      "properties": {
        "caption": {
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "caption"
      ],
      "title": "CaptionBlock",
      "type": "object"
    },
    "CassetteKeys": {
      "additionalProperties": false,
      "description": "Missing cassette keys for one scenario, one list per arm (C4).",
      "properties": {
        "baseline": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Baseline",
          "type": "array"
        },
        "candidate": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Candidate",
          "type": "array"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "title": "CassetteKeys",
      "type": "object"
    },
    "ConfidenceInterval": {
      "additionalProperties": false,
      "description": "Interval on a diagnostic or A/A number. The suite gate does not use this.\n\nDiagnostics and ``aa.false_block_ci`` may omit ``level``. The omitted\nvalue is ``1 - 2*alpha`` from ``suite.yaml``. There is no hardcoded 0.90.\nThe suite-level verdict uses ``GateConfidenceInterval``, which requires\nthe level and accepts only that suite value.",
      "properties": {
        "lower": {
          "maximum": 1,
          "minimum": -1,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "maximum": 1,
          "minimum": -1,
          "title": "Upper",
          "type": "number"
        },
        "level": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Confidence level. Omitted values use 1 - 2*alpha from suite.yaml.",
          "title": "Level"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "EnvironmentMisses": {
      "additionalProperties": false,
      "description": "Per-arm miss counts and rates. The arms are not pooled.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/ArmEnvironmentMisses"
        },
        "candidate": {
          "$ref": "#/$defs/ArmEnvironmentMisses"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "title": "EnvironmentMisses",
      "type": "object"
    },
    "GateConfidenceInterval": {
      "additionalProperties": false,
      "description": "The suite-level interval on the pass-rate difference.\n\n``level`` is required and must equal ``1 - 2*alpha`` from ``suite.yaml``\n(FR-24: one-sided alpha). Alpha 0.05 is 0.90, not 0.95. Omitting it, or\nwriting a different level, fails validation. There is no default.",
      "properties": {
        "lower": {
          "maximum": 1,
          "minimum": -1,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "maximum": 1,
          "minimum": -1,
          "title": "Upper",
          "type": "number"
        },
        "level": {
          "description": "Must equal 1 - 2*alpha from suite.yaml (the recorded ci_level). No default.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "level"
      ],
      "title": "GateConfidenceInterval",
      "type": "object"
    },
    "MDEBlock": {
      "additionalProperties": false,
      "description": "Minimum detectable effect at each rollout count. On the pass rate.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "enum": [
                "preliminary",
                "final"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "caption": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One sentence for the power table, for a non-technical reader.",
          "title": "Caption"
        },
        "undetectable": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What a drop smaller than this table comes back as. Display text only."
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/MDERow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "MDEBlock",
      "type": "object"
    },
    "MDERow": {
      "additionalProperties": false,
      "description": "One row of the power table.\n\n``rollouts`` here is a hypothetical per-scenario count on the x-axis of\nthat table. It is not ``rollouts_per_scenario`` and not ``total_rollouts``.",
      "properties": {
        "rollouts": {
          "description": "Hypothetical rollouts per scenario for this power-table row. Not the run's rollouts_per_scenario and not total_rollouts.",
          "minimum": 1,
          "title": "Rollouts",
          "type": "integer"
        },
        "minimum_detectable_effect": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Minimum Detectable Effect",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "rollouts",
        "minimum_detectable_effect"
      ],
      "title": "MDERow",
      "type": "object"
    },
    "OverallVerdict": {
      "additionalProperties": false,
      "description": "The only gate verdict. One decision for the suite.",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "block",
            "insufficient_evidence",
            "invalid_run"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "difference": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference"
        },
        "difference_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/GateConfidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "likely_regression": {
          "description": "True only when the verdict is insufficient_evidence and the point estimate is strictly below -delta (FR-25, C7). Required, no default.",
          "title": "Likely Regression",
          "type": "boolean"
        },
        "model_ids": {
          "$ref": "#/$defs/VerdictModelIds",
          "description": "Model id each arm used. Paths: verdicts.overall.model_ids.baseline and verdicts.overall.model_ids.candidate. Each arm has exactly one."
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "preliminary",
                "final"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "verdict",
        "likely_regression",
        "model_ids"
      ],
      "title": "OverallVerdict",
      "type": "object"
    },
    "ScenarioDiagnostic": {
      "additionalProperties": false,
      "description": "Pass rates and the difference for one scenario. Not a gate verdict.\n\nThe gate is the single suite-level decision on ``verdicts.overall``.",
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "family_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Id"
        },
        "scheduled_rollouts": {
          "$ref": "#/$defs/VersionRollouts",
          "description": "Scheduled rollouts of each arm for this scenario. The miss-rate denominator, and the input to the per-scenario floor."
        },
        "miss_counts": {
          "$ref": "#/$defs/VersionRollouts",
          "description": "env_miss, infra-caused timeouts, and scheduled rollouts with no recorded outcome, for each arm of this scenario."
        },
        "missing_cassette_keys": {
          "$ref": "#/$defs/CassetteKeys",
          "description": "Cassette keys that missed on this scenario (C4), in rollout order, one list per arm. Infra timeouts and unrecorded rollouts are misses without a cassette key, so a list may be shorter than miss_counts. It cannot be longer."
        },
        "baseline_pass_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Pass Rate"
        },
        "candidate_pass_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Pass Rate"
        },
        "difference": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference"
        },
        "difference_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "scenario_id",
        "scheduled_rollouts",
        "miss_counts",
        "missing_cassette_keys"
      ],
      "title": "ScenarioDiagnostic",
      "type": "object"
    },
    "VerdictLabelCaptions": {
      "additionalProperties": false,
      "description": "Plain-language sentence for each suite verdict label.\n\nThe landing page can show all four even when only one label is selected.\n``pass`` is a Python keyword, so the attribute is ``pass_``.",
      "properties": {
        "pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "block": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "insufficient_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "invalid_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "VerdictLabelCaptions",
      "type": "object"
    },
    "VerdictModelIds": {
      "additionalProperties": false,
      "description": "The one model id each arm used. Recorded on the suite verdict.",
      "properties": {
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "candidate": {
          "minLength": 1,
          "title": "Candidate",
          "type": "string"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "title": "VerdictModelIds",
      "type": "object"
    },
    "VerdictsBlock": {
      "additionalProperties": false,
      "description": "Suite gate verdict plus per-scenario diagnostics.\n\n``diagnostics`` do not carry pass / block. They are not independent gates.\n``caption`` and ``verdict_captions`` are display text. The gate ignores them.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "enum": [
                "preliminary",
                "final"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "caption": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One sentence for the suite verdict, for a non-technical reader.",
          "title": "Caption"
        },
        "verdict_captions": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictLabelCaptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overall": {
          "$ref": "#/$defs/OverallVerdict"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/ScenarioDiagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "overall",
        "diagnostics"
      ],
      "title": "VerdictsBlock",
      "type": "object"
    },
    "VersionRollouts": {
      "additionalProperties": false,
      "description": "Baseline and candidate rollout counts for one explicit scope.",
      "properties": {
        "baseline": {
          "minimum": 0,
          "title": "Baseline",
          "type": "integer"
        },
        "candidate": {
          "minimum": 0,
          "title": "Candidate",
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "title": "VersionRollouts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One ``results.json`` (or YAML) file.",
  "properties": {
    "schema_version": {
      "const": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "status": {
      "enum": [
        "preliminary",
        "final"
      ],
      "title": "Status",
      "type": "string"
    },
    "source": {
      "enum": [
        "screening",
        "baseline_pool",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "run_kind": {
      "description": "Which model-id rule this run uses. screening, baseline, and aa must share one model id across both arms. gate may use a different candidate id; the baseline arm must be baseline_pool_model_id. source is where the numbers came from and can differ: a replay of a gate run is source replay and run_kind gate.",
      "enum": [
        "screening",
        "baseline",
        "aa",
        "gate"
      ],
      "title": "Run Kind",
      "type": "string"
    },
    "suite_id": {
      "default": "tau_retail",
      "description": "Suite this document belongs to. Omitted files default to tau_retail. Gate settings still come from the packaged tau_retail suite unless --suite is set.",
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    },
    "baseline_id": {
      "minLength": 1,
      "title": "Baseline Id",
      "type": "string"
    },
    "baseline_pool_model_id": {
      "description": "Pinned baseline-pool model id, copied from suite.yaml. Gate runs require verdicts.overall.model_ids.baseline to equal this.",
      "minLength": 1,
      "title": "Baseline Pool Model Id",
      "type": "string"
    },
    "rollouts_per_scenario": {
      "$ref": "#/$defs/VersionRollouts",
      "description": "How many rollouts of each version one scenario uses. This is the suite tier setting, not the sum across the document."
    },
    "total_rollouts": {
      "$ref": "#/$defs/VersionRollouts",
      "description": "Scheduled rollouts of each version in this document, summed across scenarios. Not the per-scenario setting, and not the count of recorded outcomes."
    },
    "min_valid_fraction_per_scenario": {
      "description": "Copied from suite.yaml min_valid_fraction_per_scenario. The exact fraction string, such as \"0.6\". Not a float, and not rewritten to \"3/5\" unless the suite file itself wrote 3/5.",
      "examples": [
        "0.6"
      ],
      "title": "Min Valid Fraction Per Scenario",
      "type": "string"
    },
    "environment_misses": {
      "$ref": "#/$defs/EnvironmentMisses"
    },
    "cost_usd": {
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "verdicts": {
      "$ref": "#/$defs/VerdictsBlock"
    },
    "aa": {
      "anyOf": [
        {
          "$ref": "#/$defs/AASummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mde": {
      "$ref": "#/$defs/MDEBlock"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "source",
    "run_kind",
    "note",
    "baseline_id",
    "baseline_pool_model_id",
    "rollouts_per_scenario",
    "total_rollouts",
    "min_valid_fraction_per_scenario",
    "environment_misses",
    "cost_usd",
    "verdicts",
    "mde"
  ],
  "title": "ResultsDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci-agent-regression-harness.local/schema/results/2.1.0.json"
}
